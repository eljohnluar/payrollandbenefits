# Laravel backend environment — copy to .env and fill from the legacy
# backend/backend/.env values. Never commit the filled file.
APP_NAME="Payroll & Benefits"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Postgres: either set DB_* directly, or leave them blank and the app falls
# back to the SUPABASE_DB_* keys below (same names the legacy backend uses).
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# App JWT signing secret (HS256) used when SUPABASE_JWT_SECRET is empty.
APP_SECRET=

REGISTRATION_CODE=
# Mail / SMTP configuration (Gmail SMTP using an App Password)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Payroll & Benefits"
TABSCANNER_API_KEY=
GOOGLE_SA_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# HR1 (Recruitment) — outbound calls to https://recruitment.mms-tmglt.com
HR1_API_KEY=

# HR2 (Workforce Management) — outbound calls to https://workforce.mms-tmglt.com
HR2_API_KEY=
HR2_BASE_URL=https://workforce.mms-tmglt.com

# HR3 (Performance & Development) — outbound calls to https://performance.mms-tmglt.com
HR3_API_KEY=
