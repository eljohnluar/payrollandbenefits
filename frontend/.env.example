# Base URL of the PHP API.
# Production (HostForge): leave empty — frontend and API share the same origin,
#   so /api/* requests resolve correctly with no prefix.
# Local dev: also leave empty and let the Vite proxy (below) forward to the backend.
VITE_API_BASE=
# Where the Vite dev proxy forwards /api requests (must match php artisan serve port).
VITE_API_PROXY=http://localhost:8080

# Supabase browser keys. The anon key is public by design; row level security
# in backend/supabase/migrations is what protects the data, not secrecy here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
